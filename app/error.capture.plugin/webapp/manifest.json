{
  "_version": "1.58.0",
  "sap.app": {
    "id": "error.capture.plugin",
    "type": "component",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "2.1.0"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "ach": "CA-UI5-FE-SHL",
    "crossNavigation": {
      "inbounds": {
        "Shell-plugin": {
          "semanticObject": "Shell",
          "action": "plugin",
          "title": "{{appTitle}}",
          "hideLauncher": true,
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {},
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "componentName": "error.capture.plugin",
    "config": {
      "fullWidth": true,
      "errorCapture": {
        "_comment": "Runtime config for util/MessageInterceptor.js, util/AskAI.js, util/AskAIHeaderItem.js and util/ErrorListDialog.js - adjust per landscape without touching code.",
        "askAiUrl": "http://a9a4c03ecce524310a13b3d4c50751cd-240f53dcd8190c23.elb.us-east-1.amazonaws.com/",
        "askAiIncludeUser": true,
        "askAiMaxMessageLength": 1000,
        "askAiIcon": "sap-icon://ai",
        "addAskAiButtonToMessageBox": true,
        "showAskAiHeaderButton": true,
        "notifyErrorsWithoutDialog": true,
        "capturedSeverities": [
          "Error",
          "Warning"
        ],
        "captureUnhandledJsErrors": true,
        "captureHttpErrors": true,
        "httpErrorIgnoreUrlPatterns": [
          "\\.(js|css|properties|xml|json|woff2?|ttf|png|jpe?g|gif|svg|ico|map)(\\?|$)",
          "/resources/",
          "/test-resources/",
          "sessionKeepAlive",
          "/sap/es/ina/",
          "/ESH_SEARCH_SRV/",
          "/logout"
        ],
        "ignoreMessagePatterns": [
          "^Script error\\.?$",
          "ResizeObserver loop"
        ],
        "captureSameOriginIframes": true,
        "duplicateWindowMs": 2000
      }
    },
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ushell": {}
      }
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "error.capture.plugin.i18n.i18n"
        }
      }
    }
  },
  "sap.flp": {
    "type": "plugin"
  },
  "sap.platform.runtime": {
    "componentProperties": {
      "loadCoreExt": false
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "errorplugin.service"
  }
}
