<mvc:View
	controllerName="error.capture.plugin.test.demoapp.controller.Main"
	displayBlock="true"
	height="100%"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc">
	<Page title="Demo Custom Tile">
		<content>
			<VBox class="sapUiMediumMargin">
				<Text text="Use these buttons to simulate messages a custom-built Fiori tile might raise. Error and warning dialogs get an 'Ask AI' button. Every captured error is also counted on the Ask AI button in the launchpad header, which lists this app's errors, each with its own Ask AI button." class="sapUiSmallMarginBottom"/>
				<Button text="Trigger MessageBox.error (M3/305)" type="Reject" press="onTriggerMessageBoxError" class="sapUiTinyMarginBottom"/>
				<Button text="Trigger MessageBox.warning" press="onTriggerMessageBoxWarning" class="sapUiTinyMarginBottom"/>
				<Button text="Trigger MessageBox.confirm (no Ask AI)" press="onTriggerMessageBoxConfirm" class="sapUiTinyMarginBottom"/>
				<Button text="Trigger validation message (MessageManager)" press="onTriggerMessageManager" class="sapUiTinyMarginBottom"/>
				<Button text="Trigger failed service call (HTTP 404)" press="onTriggerFailedCall" class="sapUiTinyMarginBottom"/>
				<Button text="Trigger uncaught JS error" press="onTriggerJsError" class="sapUiTinyMarginBottom"/>
			</VBox>
		</content>
	</Page>
</mvc:View>
